# Copy to .env.local for local work; set the same names in Vercel →
# Settings → Environment Variables for Production. Never commit real values.

# Vercel Blob store (demo videos, profile photo, resume PDF).
BLOB_READ_WRITE_TOKEN=

# Resume gate (src/app/api/resume). The page shows "PDF coming soon" until
# all five of these (with the Blob token) are set at build time.
# resend.com → API Keys. Server only.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Kelvin Wilch <resume@wilch.dev>
RESUME_FROM_EMAIL=
# Where your "someone downloaded your resume" copy goes.
RESUME_NOTIFY_EMAIL=
# Signs the download links. Make one with: openssl rand -base64 48
RESUME_LINK_SECRET=
